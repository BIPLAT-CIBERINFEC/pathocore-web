{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/pages/data-tools/genomic-data.jsx", "src/components/GenomicData/Graficos/SchemaDistribution.jsx", "src/pages/use-cases/mepram.jsx", "src/components/UseCases/Mepram/MepramDataPage.tsx", "src/pages/api/v1/use-cases/data-summary.js", "src/components/GenomicData/index.jsx"],
  "exclude": ["node_modules"]
}
