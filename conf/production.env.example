# PathoCore production compose settings.
# Copy this file to a deployment-managed path, for example:
#   /srv/containers/bind/pathocore-web/production.env
#
# Values marked CHANGE_ME must be reviewed before deployment.
# Do not commit the real production env file.

COMPOSE_PROJECT_NAME=pathocore

# Public Apache entrypoint
HTTP_BIND_HOST=0.0.0.0
HTTP_PORT=80
PATHOCORE_DATAHUB_SERVER_NAME=CHANGE_ME_DATAHUB_DNS
PATHOCORE_API_SERVER_NAME=CHANGE_ME_PATHOCORE_API_DNS
PATHOCORE_KEYCLOAK_SERVER_NAME=CHANGE_ME_KEYCLOAK_DNS
MEPRAM_OMOP_API_SERVER_NAME=CHANGE_ME_OMOP_API_DNS
PATHOCORE_FORWARDED_PROTO=https
PATHOCORE_FORWARDED_PORT=443

# Production secrets
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
MEPRAM_DB_PASSWORD=CHANGE_ME
MEPRAM_DB_ROOT_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_ROOT_PASSWORD=CHANGE_ME
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
MEPRAM_DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME

# Database names/users
DB_NAME=pathocore_api
DB_USER=pathocore
MEPRAM_DB_NAME=mepram_omop_api
MEPRAM_DB_USER=mepram
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak

# Admin users
PATHOCORE_CREATE_DEFAULT_SUPERUSER=true
DJANGO_SUPERUSER_USERNAME=CHANGE_ME_ADMIN_USER
DJANGO_SUPERUSER_EMAIL=CHANGE_ME_ADMIN_EMAIL
MEPRAM_CREATE_DEFAULT_SUPERUSER=true
MEPRAM_DJANGO_SUPERUSER_USERNAME=CHANGE_ME_ADMIN_USER
MEPRAM_DJANGO_SUPERUSER_EMAIL=CHANGE_ME_ADMIN_EMAIL
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_KEYCLOAK_ADMIN_USER

# Public URLs
KEYCLOAK_PUBLIC_URL=https://CHANGE_ME_KEYCLOAK_DNS
KEYCLOAK_ISSUER=https://CHANGE_ME_KEYCLOAK_DNS/realms/ciberisciii_datahub
NEXT_PUBLIC_KEYCLOAK_URL=https://CHANGE_ME_KEYCLOAK_DNS
AUTH_URL=https://CHANGE_ME_DATAHUB_DNS
AUTH_TRUST_HOST=true
PATHOCORE_API_DNS_URL=CHANGE_ME_PATHOCORE_API_DNS

# Keycloak integration
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/ciberisciii_datahub/protocol/openid-connect/certs
KEYCLOAK_REALM=ciberisciii_datahub
KEYCLOAK_AUDIENCE=pathocore-api
KEYCLOAK_CLIENT_ID=pathocore-web
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN_TOKEN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=CHANGE_ME_KEYCLOAK_ADMIN_USER
KEYCLOAK_ADMIN_REQUEST_TIMEOUT_SECONDS=10
KEYCLOAK_ADMIN_SEND_ACTION_EMAILS=true
# Optional. Redirect after Keycloak action emails such as password setup.
KEYCLOAK_ADMIN_ACTION_EMAIL_REDIRECT_URI=
# Optional fallback/copy recipients if no use-case admins are found in Keycloak.
PATHOCORE_ACCESS_REQUEST_ADMIN_EMAILS=

# API and frontend behavior
PATHOCORE_API_GIT_REVISION=current
PATHOCORE_API_INSTALL_CONF=conf/docker_production_settings.txt
PATHOCORE_ENABLE_LEGACY_BASIC_AUTH=true
PATHOCORE_ENABLE_PUBLIC_READ_ENDPOINTS=true
PUBLIC_API_THROTTLE_RATE=500/hour
MEPRAM_PUBLIC_API_THROTTLE_RATE=500/hour
DJANGO_DEBUG=false
LOAD_INITIAL_TABLES=false
PATHOCORE_API_LOCAL_SERVER_IP=127.0.0.1
MEPRAM_API_DEBUG=false
MEPRAM_DASHBOARD_SCHEMA=mepram_omop_api
# Optional overrides. By default these are derived from the public hostnames above:
# MEPRAM_API_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,CHANGE_ME_OMOP_API_DNS
# MEPRAM_CORS_ALLOWED_ORIGINS=https://CHANGE_ME_DATAHUB_DNS
# MEPRAM_CSRF_TRUSTED_ORIGINS=https://CHANGE_ME_OMOP_API_DNS

NEXT_PUBLIC_API_BASE_URL=/api/pathocore/v1
NEXT_PUBLIC_MEPRAM_API_BASE_URL=/api/omop/v1
PATHOCORE_API_PROXY_TARGET=http://pathocore_api:8000
MEPRAM_OMOP_API_PROXY_TARGET=http://mepram_omop_api:8000
NEXT_PUBLIC_KEYCLOAK_REALM=ciberisciii_datahub
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=pathocore-web
NEXT_PUBLIC_USE_CASE_DATA_MODE=live

# Email sent by PathoCore API through the configured SMTP endpoint.
# Examples: host.docker.internal, smtp-relay, smtp.example.org
EMAIL_HOST=CHANGE_ME_SMTP_HOST
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=CHANGE_ME_FROM_EMAIL
ALLOWED_EMAIL_DOMAINS=

# Logs and runtime tuning
PATHOCORE_HOST_LOG_DIR=/var/log/local/pathocore-api/apps
PATHOCORE_HOST_APACHE_LOG_DIR=/var/log/local/pathocore-web/apache
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
MEPRAM_GUNICORN_WORKERS=2
MEPRAM_GUNICORN_THREADS=2
MEPRAM_GUNICORN_TIMEOUT=120

# Background cache
DATABROWSER_CACHE_SCHEDULER_ENABLED=true
DATABROWSER_CACHE_REFRESH_WEEKDAY=4
DATABROWSER_CACHE_REFRESH_TIME=12:00
DATABROWSER_CACHE_REFRESH_ON_START=false
