# Copy to /etc/pathocore-deploy-dev.env (root:root, 0644). No secrets here:
# deployment settings stay in each checkout's protected configuration.
DEPLOY_ROOT=/opt/container_apps
WEB_BRANCH=dev
API_BRANCH=develop
GITHUB_OWNER=BIPLAT-CIBERINFEC
DEPLOY_MODE=test
DEPLOY_ENGINE=docker
DEPLOY_HEALTH_URLS="https://mepram-des-datahub.ciberisciii.es/health https://mepram-des-api-pathocore.ciberisciii.es/v1/swagger/"
