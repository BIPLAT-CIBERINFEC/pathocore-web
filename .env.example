# Frontend-only development against running APIs and Keycloak.
# Copy to .env.local, replace the CHANGE_ME values, then run npm install and
# npm run dev. Full platform test/prod settings are managed separately by
# container_install.sh and conf/docker_*_settings.txt.

# Browser-visible paths. Keep these relative to use the Next.js API proxy.
NEXT_PUBLIC_API_BASE_URL=/api/pathocore/v1
NEXT_PUBLIC_MEPRAM_API_BASE_URL=/api/omop/v1

# Server-side proxy targets used by the Next.js development server.
PATHOCORE_API_PROXY_TARGET=https://CHANGE_ME_PATHOCORE_API_DNS
MEPRAM_OMOP_API_PROXY_TARGET=https://CHANGE_ME_OMOP_API_DNS

# Public Keycloak configuration. These values are embedded in the browser
# bundle and therefore must not contain secrets.
NEXT_PUBLIC_KEYCLOAK_URL=https://CHANGE_ME_KEYCLOAK_DNS
NEXT_PUBLIC_KEYCLOAK_REALM=CHANGE_ME_REALM
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=pathocore-web

# Use live API data unless a developer intentionally selects another mode.
NEXT_PUBLIC_USE_CASE_DATA_MODE=live
